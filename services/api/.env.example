# Copy this to .env and adjust for your environment
# For local SQLite development: leave DATABASE_URL empty
# For Docker PostgreSQL: DATABASE_URL=postgresql://nutrition_user:nutrition_password@db:5432/nutrition_db

DATABASE_URL=
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
